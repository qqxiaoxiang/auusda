---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us - Auusda" description="Contact Auusda for after-sales service and support. Call our hotline or email us 24/7.">
  <!-- Hero Banner Section -->
  <section class="relative w-full h-[50vh] min-h-[400px] overflow-hidden">
    <img 
      src="https://res.cloudinary.com/dcfcz3rvj/image/upload/f_auto,q_auto/ali//@sc02/kf/H815e2b17528449cea027e85b07db3e94t.jpg?hasNWGrade=" 
      alt="Auusda Laptop Manufacturing" 
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end">
      <div class="container mx-auto px-4 py-16 text-white">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Contact Us</h1>
        <p class="text-lg md:text-xl max-w-3xl">AUUSDA Laptop Company — Get in touch with our after-sales service team today.</p>
      </div>
    </div>
  </section>

  <!-- Contact Information Section -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <!-- Company Name -->
        <div class="mb-12">
          <h2 class="text-4xl font-bold text-gray-900 tracking-wider">AUUSDA LAPTOP COMPANY</h2>
        </div>

        <!-- Phone -->
        <div class="bg-gray-50 p-10 rounded-lg shadow-md mb-8">
          <div class="flex items-center justify-center space-x-4 mb-4">
            <div class="bg-green-100 w-14 h-14 rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-semibold text-gray-900">After-Sales Service Hotline</h3>
          </div>
          <p class="text-4xl font-bold text-blue-600 mb-3">+86 180-0774-2884</p>
          <p class="text-gray-600 text-lg">7×24 Hours Service Available</p>
        </div>

        <!-- Email -->
        <div class="bg-gray-50 p-10 rounded-lg shadow-md mb-8">
          <div class="flex items-center justify-center space-x-4 mb-4">
            <div class="bg-blue-100 w-14 h-14 rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-7 h-7 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-semibold text-gray-900">Email Support</h3>
          </div>
          <p class="text-gray-600 text-lg mb-2">For email support:</p>
          <a 
            href="mailto:SupportUS@auusdalaptop.com" 
            class="text-2xl font-bold text-blue-600 hover:text-blue-800"
          >
            SupportUS@auusdalaptop.com
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="py-20 bg-blue-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">Need Help? We Are Here For You</h2>
      <p class="text-lg md:text-xl mb-8 max-w-3xl mx-auto">Our after-sales service team is available 24/7 to assist you with any questions or concerns.</p>
      <div class="flex flex-col sm:flex-row justify-center space-y-4 sm:space-y-0 sm:space-x-6">
        <a 
          href="tel:+8618007742884" 
          class="bg-white text-blue-600 px-8 py-3 rounded-md hover:bg-gray-100 transition-colors text-lg font-medium flex items-center justify-center space-x-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span>Call Now</span>
        </a>
        <a 
          href="mailto:SupportUS@auusdalaptop.com" 
          class="bg-transparent border-2 border-white text-white px-8 py-3 rounded-md hover:bg-white hover:text-blue-600 transition-colors text-lg font-medium"
        >
          Send Email
        </a>
      </div>
    </div>
  </section>
</Layout>
